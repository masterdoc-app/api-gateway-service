# Copy to /etc/masterdoc-api-gateway/.env on the VPS.
PORT=8083
ZITADEL_ISSUER=https://auth.fixaverse.ru
ZITADEL_JWK_SET_URI=https://auth.fixaverse.ru/oauth/v2/keys
# host.docker.internal → VPS (see docker-compose extra_hosts)
FEATURE_SERVICE_BASE_URL=http://host.docker.internal:8082
BACKEND_BASE_URL=http://host.docker.internal:8081
CORS_ORIGINS=https://copilot.formaverse.ru,https://copilot.masterdoc.pro,http://localhost:8080
