# Copy to /etc/masterdoc-api-gateway/.env on the VPS.
PORT=8083
ZITADEL_ISSUER=https://auth.fixaverse.ru
ZITADEL_JWK_SET_URI=https://auth.fixaverse.ru/oauth/v2/keys
# Zitadel Management API — server-only PAT; never expose to browser or client apps.
# PAT must manage users and project grants in the org (dedicated machine user, not a human admin password).
ZITADEL_ORG_ID=
ZITADEL_PROJECT_ID=
ZITADEL_MGMT_TOKEN=
# host.docker.internal → VPS (see docker-compose extra_hosts)
FEATURE_SERVICE_BASE_URL=http://host.docker.internal:8082
BACKEND_BASE_URL=http://host.docker.internal:8081
CORS_ORIGINS=https://app.fixaverse.ru,https://copilot.fixaverse.ru,https://copilot.formaverse.ru,https://copilot.masterdoc.pro,http://localhost:8080
