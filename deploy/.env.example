# Copy to /etc/masterdoc-api-gateway/.env on the VPS.
PORT=8083
ZITADEL_ISSUER=https://auth.fixaverse.ru
ZITADEL_JWK_SET_URI=https://auth.fixaverse.ru/oauth/v2/keys
# Zitadel Management API — server-only PAT; never expose to browser or client apps.
# Admin org comes from JWT claim urn:zitadel:iam:org:id (TenantContext), not env.
# PAT must manage users and project grants across client orgs (dedicated machine user, not a human admin password).
ZITADEL_PROJECT_ID=
ZITADEL_MGMT_TOKEN=
# host.docker.internal → VPS (see docker-compose extra_hosts)
FEATURE_SERVICE_BASE_URL=http://feature-service:8082
BACKEND_BASE_URL=http://host.docker.internal:8081
CATALOG_SERVICE_BASE_URL=http://host.docker.internal:8091
DASHBOARD_SERVICE_BASE_URL=http://host.docker.internal:8092
MAINTENANCE_SERVICE_BASE_URL=http://host.docker.internal:8098
DOCUMENT_SERVICE_BASE_URL=http://host.docker.internal:8093
TECHNOLOGIST_SERVICE_BASE_URL=http://host.docker.internal:8095
BLACK_BOX_SERVICE_BASE_URL=http://host.docker.internal:8096
MAP_SERVICE_BASE_URL=http://host.docker.internal:8100
BLACK_BOX_INTERNAL_TOKEN=
CORS_ORIGINS=https://app.fixaverse.ru,https://copilot.fixaverse.ru,https://copilot.masterdoc.pro,http://localhost:8080
